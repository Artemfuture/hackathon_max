# Токен чат-бота, выданный организаторами хакатона для платформы MAX.
# Не коммитьте реальный токен — используйте .env (добавлен в .gitignore/.dockerignore).
MAX_BOT_TOKEN=

# Базовый адрес MAX Bot API. Оставьте пустым — по умолчанию https://platform-api2.max.ru.
MAX_API_BASE_URL=

# TRANSPORT=console запускает локальный режим без обращения к MAX (для проверки ответов бота).
# TRANSPORT=max (по умолчанию) запускает long polling к MAX Bot API — требует MAX_BOT_TOKEN.
TRANSPORT=max

# Порт мини-приложения на этом компьютере: http://localhost:3000 (только для docker compose).
APP_PORT=3000

# Ник бота в MAX без «@» (например, my_dosug_bot). Попадает в ссылки-приглашения
# https://max.ru/<ник>?startapp=… при СБОРКЕ мини-приложения: после изменения пересоберите образ.
VITE_BOT_NAME=

# За сколько минут до начала бот напоминает о выбранном вечере (по умолчанию 60).
REMINDER_LEAD_MINUTES=

# Как часто бот проверяет, не пора ли отправить напоминания, в секундах (по умолчанию 30).
REMINDER_CHECK_SECONDS=

# Часовой пояс города в минутах от UTC: по нему считается «сегодня в 19:00» (по умолчанию 180 — Казань, UTC+3).
EVENT_UTC_OFFSET_MIN=

# Реальная афиша KudaGo (выставки, экскурсии, спектакли): off — не загружать. По умолчанию включена.
KUDAGO=

# Город KudaGo: kzn — Казань (по умолчанию).
KUDAGO_LOCATION=

# Тестовые события для демонстрации: off — убрать их, останутся места города, кафе, спорт и афиша KudaGo.
DEMO_EVENTS=

# Домен для запуска на сервере: docker compose --profile prod up -d --build
# Его A-запись должна указывать на IP сервера. Локально не нужен.
DOMAIN=
